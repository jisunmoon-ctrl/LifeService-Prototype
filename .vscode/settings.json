{
  // 로컬 프리뷰 URL(5179~5183)은 외부 브라우저 대신 Cursor 내장 Simple Browser 로 연다.
  // `simpleBrowser.open` 은 built-in simple-browser 확장이 등록하는 external URI opener id 이며
  // localhost / 127.0.0.1 계열 호스트만 처리한다.
  "workbench.externalUriOpeners": {
    "http://localhost:*": "simpleBrowser.open",
    "http://127.0.0.1:*": "simpleBrowser.open"
  },

  // 폴더를 열면 `preview: 전체 실행` 이 자동으로 뜨도록 허용 (tasks.json 의 runOn: folderOpen)
  "task.allowAutomaticTasks": "on"
}
